DATABASE_URL="postgresql://user:password@localhost:5432/expediente_pedagogico?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
# Envío de correos vía Gmail SMTP (Nodemailer). GMAIL_USER es la cuenta de
# Gmail que envía; GMAIL_APP_PASSWORD es una "contraseña de aplicación" de
# 16 caracteres generada en https://myaccount.google.com/apppasswords
# (requiere verificación en 2 pasos activada en esa cuenta). Sin estas dos
# variables, los correos solo se registran en consola, no se envían.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM="no-reply@tuescuela.com"
MAIL_BCC_ADMIN="administracion@tuescuela.com"
PORT=3001
# Origen(es) permitidos por CORS, separados por coma. En local se puede omitir
# (permite cualquier origen); en producción debe ser la URL del frontend.
FRONTEND_URL="https://tu-frontend.vercel.app"
